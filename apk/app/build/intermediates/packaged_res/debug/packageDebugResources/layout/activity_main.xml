<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

        <!-- 主内容区域 -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bottomInputContainer"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 顶部问候语 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi，今天从哪里开始？"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="32dp" />

                <!-- 示例问题列表 -->
                <TextView
                    android:id="@+id/tvExample1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开京东搜索感冒药"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvExample2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开淘宝搜索维生素C"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvExample3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开美团点外卖"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- 底部输入区域 -->
        <LinearLayout
            android:id="@+id/bottomInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 输入框容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/editbox_background"
                android:backgroundTint="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:elevation="4dp">

                <!-- 键盘/语音切换按钮 -->
                <TextView
                    android:id="@+id/btnInputMode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⌨️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- 文字输入框（键盘模式） -->
                <EditText
                    android:id="@+id/etQuery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:hint="发消息或按住说话..."
                    android:textColorHint="#999999"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:maxLines="4"
                    android:inputType="textMultiLine"
                    android:visibility="visible" />

                <!-- 语音输入按钮（语音模式） -->
                <TextView
                    android:id="@+id/btnVoiceInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#E0E0E0"
                    android:text="按住 说话"
                    android:textColor="#666666"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <!-- 发送按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="发送"
                    android:textSize="14sp"
                    android:minWidth="60dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="20dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 浮动停止按钮 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabStopTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="停止任务"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomInputContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:backgroundTint="@color/error" />

        <!-- 隐藏的UI元素（保持兼容性） -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewAccessibilityStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAccessibilityStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopTask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
